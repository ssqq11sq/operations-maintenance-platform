# API
PORT=3000
NODE_ENV=development
JWT_SECRET=omp-dev-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# Database: sqlite (default local demo via sql.js) | mysql
DB_TYPE=sqlite
DB_DATABASE=./data/omp.sqlite
# MySQL (when DB_TYPE=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=omp
DB_PASSWORD=omp123
DB_NAME=omp
DB_SYNC=true

# Redis (optional in MVP; falls back to in-memory if unavailable)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_ENABLED=false

# File storage: local | minio
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=
# 本地开发留空，返回相对路径 /uploads/...，由前端同源代理访问
# 正式环境可设为 https://your-domain.com

# 高德地图
# Web 端 JS API：填到 apps/web/.env 的 VITE_AMAP_KEY / VITE_AMAP_SECURITY_CODE
# 小程序：填到 apps/mobile/.env 的 VITE_AMAP_MP_KEY
# Web服务（逆地理编码，后端用）：
AMAP_KEY=

# MinIO (when STORAGE_DRIVER=minio)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=omp-files

# Web
VITE_API_BASE_URL=http://localhost:3000/api

# Mobile (H5)
UNI_API_BASE_URL=http://localhost:3000/api

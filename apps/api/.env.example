# 数据库（默认 sql.js，无需 Docker）
DB_TYPE=sqljs
# DB_TYPE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=omp
# DB_PASSWORD=omp123
# DB_NAME=omp
DB_SYNC=true

JWT_SECRET=change-me-in-production
PORT=3000

# 高德「Web服务」Key（逆地理编码 /api/geo/regeo）
# 注意：不能使用 Web端(JS API) 或微信小程序 Key
AMAP_KEY=

# 短信登录（默认 mock：验证码打日志并在接口返回 devCode）
SMS_MOCK=true
SMS_CODE_TTL_SEC=300

# 微信小程序登录（不填则 mock）
WECHAT_MP_APPID=
WECHAT_MP_SECRET=

# 短信/微信首次登录是否自动注册 STAFF 账号
AUTH_AUTO_REGISTER=true

# 仅首次初始化：清空全部账号/团队/业务数据后重建超级管理员（用完请改回 false）
OMP_RESET_DATA=false
SEED_SUPER_USERNAME=superadmin
SEED_SUPER_PASSWORD=Omp@2026Super
SEED_SUPER_DISPLAY_NAME=超级管理员

STORAGE_DRIVER=local
UPLOAD_DIR=uploads
